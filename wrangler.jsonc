// The marketing page in site/, served by a static-assets-only Worker on
// Cloudflare (D35). No script runs: Cloudflare serves the files directly.
// Deployed by .github/workflows/site.yml; spotussi.app was attached once
// as a custom domain, and deploys without `routes` leave it in place.
{
  "name": "spotussi",
  "compatibility_date": "2026-10-01",
  "assets": {
    // site/.assetsignore keeps the folder's README out of the upload.
    "directory": "site"
  },
  // Production lives only on spotussi.app; pull requests upload a version
  // with a preview alias on workers.dev (see the workflow).
  "workers_dev": false,
  "preview_urls": true
}
